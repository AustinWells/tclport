+#ifdef TCL_CHAR_TABLE_RUNTIME_INIT
+/*
+ *----------------------------------------------------------------------
+ *
+ * InitCharTypeTable --
+ *
+ *	Initialize the character type table for EBCDIC systems.
+ *	This maps actual character values to their types.
+ *
+ * Results:
+ *	None.
+ *
+ * Side effects:
+ *	Initializes the tclCharTypeTable array.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static void
+InitCharTypeTable(void)
+{
+    int i;
+
+    /* Initialize all to TYPE_NORMAL */
+    for (i = 0; i < 256; i++) {
+        tclCharTypeTable[i] = TYPE_NORMAL;
+    }
+
+    /* Set special characters based on actual character encoding */
+    tclCharTypeTable[(unsigned char)'\0'] = TYPE_SUBS;        /* null */
+    tclCharTypeTable[(unsigned char)'\t'] = TYPE_SPACE;       /* tab */
+    tclCharTypeTable[(unsigned char)'\n'] = TYPE_COMMAND_END; /* newline */
+    tclCharTypeTable[(unsigned char)'\v'] = TYPE_SPACE;       /* vertical tab */
+    tclCharTypeTable[(unsigned char)'\f'] = TYPE_SPACE;       /* form feed */
+    tclCharTypeTable[(unsigned char)'\r'] = TYPE_SPACE;       /* carriage return */
+    tclCharTypeTable[(unsigned char)' '] = TYPE_SPACE;        /* space */
+    tclCharTypeTable[(unsigned char)'"'] = TYPE_QUOTE;        /* double quote */
+    tclCharTypeTable[(unsigned char)'$'] = TYPE_SUBS;         /* dollar */
+    tclCharTypeTable[(unsigned char)'('] = TYPE_OPEN_PAREN;   /* open paren */
+    tclCharTypeTable[(unsigned char)')'] = TYPE_CLOSE_PAREN;  /* close paren */
+    tclCharTypeTable[(unsigned char)';'] = TYPE_COMMAND_END;  /* semicolon */
+    tclCharTypeTable[(unsigned char)'['] = TYPE_SUBS;         /* open bracket */
+    tclCharTypeTable[(unsigned char)'\\'] = TYPE_SUBS;       /* backslash */
+    tclCharTypeTable[(unsigned char)']'] = TYPE_CLOSE_BRACK;  /* close bracket */
+    tclCharTypeTable[(unsigned char)'{'] = TYPE_BRACE;        /* open brace */
+    tclCharTypeTable[(unsigned char)'}'] = TYPE_BRACE;        /* close brace */
+}
+#endif /* TCL_CHAR_TABLE_RUNTIME_INIT */
 
